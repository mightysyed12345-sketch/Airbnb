<style>
  .navbar-search-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #e5e5e5;
    border-radius: 999px;
    background: #fff;
    padding: 0.2rem 0.5rem 0.2rem 0.9rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }

  .navbar-search-form input {
    border: none;
    box-shadow: none;
    background: transparent;
    min-width: 180px;
  }

  .navbar-search-form input:focus {
    box-shadow: none;
    border: none;
  }

  .btn.btn-search {
    background-color: #ff385c !important;
    color: white !important;
    border: none !important;
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    min-width: 120px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .btn.btn-search:hover {
    background-color: #e52f52 !important;
    color: white !important;
  }

  .btn.btn-search i {
    font-size: 0.9rem;
    color: white;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button 
    class="navbar-toggler" 
    type="button" 
    data-bs-toggle="collapse" 
    data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form class="navbar-search-form" role="search" action="/listings" method="GET">
            <input class="form-control" type="search" name="search" placeholder="Search Destinations" aria-label="Search by country" value="<%= typeof search !== 'undefined' ? search : '' %>"/>
            <button class="btn btn-search" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i>
              <span>Search</span>
            </button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <% if(!currUser)  { %>
        <a class="nav-link" href="/listings/new">Airbnb your Home</a>
        <a class="nav-link" aria-current="page" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% }  %>
         <% if(currUser)  {  %>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% }  %>
      </div>
  </div>
</nav>

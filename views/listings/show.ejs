<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
    <div class="col-8 offset-2 mb-3">
        <div class="card-col-6 offset-2 show-card listing-card">
            <h3> <%=listing.title%> </h3>
            <img src="<%=listing.image.url%>"
             class="card-img-top show-img"
             alt="listing_image">
            <div class="card-body">
                <p class="card-text"></p>
                <%=listing.description %><br>
                &#8377;<%=Number(listing.price).toLocaleString("en-IN")%><br>
                <p><%=listing.location%>,
                <%=listing.country %></p>
            </div>
        </div>
        <!-- Replace your button section with this clean flex layout -->
        <div class="d-flex gap-2 mt-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-sm px-4">Edit</a>
    
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-danger btn-sm px-4">Delete</button>
            </form>
        </div>
    </div>
    <div class="col-8 offset-3">
        <h4>Leave a Review</h4>
        <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating">Rating:</label>
                <input type="range" name="review[rating]" min="1" max="5" id="rating"  class="form-range">
            </div>
            <div class="mb-3 mt-3">
                <label for="comment">Comment:</label>
                <textarea name="review[comment]" cols="30" rows="3" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add a comment for the review</div>
            </div>
            <button class="btn btn-outline-dark">Submit Review</button>
        </form>
        <hr/>
        <h4><b>All Reviews</b></h4>
        <div class="row">
        <% for(review of listing.reviews)  { %>
            <div class="card col-5 ms-3 mb-3">
                <div class="card-body">
                    <h5 class="card-title">Jane-Doe</h5>
                    <p class="card-text"> Rating: <%= review.comment %></p>
                    <p class="card-text"><%=review.rating %>Stars</p>
                </div>
                <form class="mb-3" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                    <button class="btn btn-sm btn-dark">Delete</button>
                </form>
            </div>
        <%  } %>
        </div>
    </div>
</div>

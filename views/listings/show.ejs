<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
    <div class="col-8 offset-2">
        <h3> Listing Details :</h3>
        <div class="card-col-6 offset-2">
            <img src="<%=listing.image.url%>"
             class="card-img-top show-img"
             alt="listing_image">
            <div class="card-body">
                <p class="card-text"><%=listing.title %></p>
                <b><%=listing.title%></b><br>
                <%=listing.description %><br>
                &#8377;<%=Number(listing.price).toLocaleString("en-IN")%><br>
                <p><%=listing.location%>,
                <%=listing.country %></p>
            </div>
        </div>
        <!-- Replace your button section with this clean flex layout -->
        <div class="d-flex gap-2 mt-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-sm px-4">Edit</a>
    
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
                <button class="btn btn-danger btn-sm px-4">Delete</button>
            </form>
        </div>
    </div>
</div>
